# Copie para .env (que NUNCA vai para o git: o repositório é público).
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=canteiro
# segredo do JWT do login próprio: gere com  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
# token que o serviço do agente (canteiro-agente) usa nas rotas internas; o MESMO valor lá (gere como o JWT_SEGREDO)
TOKEN_SERVICO_AGENTE=
# cifra a chave própria dos clientes no banco (32 bytes em base64):
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CHAVE_CIFRA=
# senha do admin de exemplo do seed (python -m canteiro_api.seed); só no .env local
SEED_ADMIN_EMAIL=admin@casavilanova.exemplo
SEED_ADMIN_SENHA=
# segredo que o servidor do Next (canteiro-web) manda em cada repasse; o MESMO valor lá
PROXY_SEGREDO=
# IPs/redes (vírgula) de proxies de confiança, ex.: o servidor do Next. Vazio = X-Forwarded-For é ignorado.
TRUSTED_PROXIES=
# cabeçalho com o IP do visitante que a borda sobrescreve (o cliente não forja). No Render: cf-connecting-ip.
IP_CABECALHO=
# origens (vírgula) que podem chamar POST /lista-espera do navegador; nunca "*". Padrão: a landing local (Astro, 4321).
CORS_ORIGENS=http://localhost:4321,http://127.0.0.1:4321
# cadastros na lista de espera por IP a cada janela de tentativas (15 min)
LISTA_ESPERA_POR_IP=10

# desenvolvimento | producao. Em producao a API não sobe com ARQUIVOS diferente de mongo.
AMBIENTE=desenvolvimento
# Arquivos dos comprovantes de gasto: mongo (GridFS no mesmo banco; padrão), disco (pasta local .arquivos/, fora do
# git; só desenvolvimento) ou memoria
ARQUIVOS=mongo
